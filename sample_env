################################################################################
# Ahead of the Storm - Environment Variables Configuration
################################################################################
# Copy this file to .env and fill in the values for your environment
# cp sample_env .env

################################################################################
# REQUIRED: Snowflake Configuration
################################################################################
# Snowflake is the data source for raw hurricane forecast data (tracks, envelopes)
# Choose ONE authentication method below:

# Method 1: Standard Password Authentication (default)
export SNOWFLAKE_ACCOUNT=''
export SNOWFLAKE_USER=''
export SNOWFLAKE_PASSWORD=''
export SNOWFLAKE_WAREHOUSE=''
export SNOWFLAKE_DATABASE=''
export SNOWFLAKE_SCHEMA=''

# Method 2: SPCS OAuth Authentication (for Snowflake Container Services deployment)
# Set SPCS_RUN=true and provide SPCS connection details instead of password
export SPCS_RUN='false'
export SPCS_TOKEN_PATH='/snowflake/session/token'
export SNOWFLAKE_HOST=''
export SNOWFLAKE_PORT=''

# Optional: read-only credentials, used instead of SNOWFLAKE_USER/SNOWFLAKE_PASSWORD
# when SNOWFLAKE_USE_RO=true (a separate, more restricted role for read-only deployments)
export SNOWFLAKE_USE_RO='false'
export SNOWFLAKE_RO_USER=''
export SNOWFLAKE_RO_PASSWORD=''

################################################################################
# REQUIRED: Application Data Paths
################################################################################
# These paths point to where pre-processed impact views are stored
# For local: Use relative or absolute paths
# (the production SPCS service spec does not mount a volume at all: it runs
# with IMPACT_DATA_STORE=SNOWFLAKE, bypassing local paths entirely; the
# Dockerfile's VOLUME declaration is /DataStore, capitalized, and unused)
export ROOT_DATA_DIR="geodb"
export VIEWS_DIR="aos_views"

################################################################################
# REQUIRED: Impact Data Storage
################################################################################
# Selects how the tile server loads impact data
# Options:
#   - 'LOCAL': Read the *_views/ files from the local filesystem (default)
#     * For local development
#     * Real production SPCS deployment uses SNOWFLAKE instead, not a mounted volume
#   - 'BLOB': Read the *_views/ files from Azure Blob Storage (read-only)
#   - 'SNOWFLAKE': Query the *_MAT tables in Snowflake directly (no file downloads)
# Raw global river and precip files are read from the Snowflake stage or Blob.
export IMPACT_DATA_STORE='LOCAL'
#export IMPACT_DATA_STORE='BLOB'
#export IMPACT_DATA_STORE='SNOWFLAKE'

################################################################################
# OPTIONAL: Azure Blob Storage (only if IMPACT_DATA_STORE='BLOB')
################################################################################
# Required only if using Azure Blob Storage for impact views
# These variables are used by the giga-spatial library's ADLSDataStore
export ADLS_ACCOUNT_URL=""
export ADLS_SAS_TOKEN=""
export ADLS_CONTAINER_NAME=""
################################################################################
# OPTIONAL: Snowflake Stage (only if IMPACT_DATA_STORE='SNOWFLAKE')
################################################################################
# Required only if using Snowflake stage for the raw river/precip files
# This is the name of the Snowflake internal stage where the raw river/precip files are stored
# Note: Snowflake stages use standard password authentication (SPCS_RUN=false)
export SNOWFLAKE_STAGE_NAME=""

################################################################################
# OPTIONAL: Mapbox (for map visualization)
################################################################################
# If not set, the app will use OpenStreetMap tiles as fallback
export MAPBOX_ACCESS_TOKEN=""

################################################################################
# OPTIONAL: Tile server URL / reverse-proxy mode
################################################################################
# TILE_SERVER_URL: base URL the browser uses for tile/geojson requests.
#   Local dev default (BEHIND_REVERSE_PROXY unset/false): http://localhost:8001
#   Set explicitly only if the tile server runs on a different host.
export TILE_SERVER_URL=""
# BEHIND_REVERSE_PROXY: set true when nginx fronts both Dash and the tile server on the
# same host (SPCS or Azure): the browser is then sent an empty TILE_SERVER_URL and
# resolves tile/geojson requests against window.location.origin instead.
export BEHIND_REVERSE_PROXY='false'


################################################################################
# OPTIONAL: River flood-extent source (tile server, global river-raw layer)
################################################################################
# auto (default): read the compact GloFAS "bymask" Parquet when it exists in Blob for the
#   requested date and return period, otherwise the by-member Parquet.
# bymask: require the compact file (a missing one is an error).
# bymember: never read the compact file (a cycle that has only the compact file is an error).
# A cycle that has only the compact file is an error in every mode if that file cannot be read.
export RIVER_EXTENT_SOURCE='auto'
